# Copiar este archivo como .env solo si se quieren cambiar los valores por defecto.
# Sin .env, docker compose levanta todo en modo local con estos mismos valores.

# --- Base de datos ---
DB_NAME=gestionobra
DB_USER=gestionobra
DB_PASSWORD=gestionobra

# --- Correo (local: Mailpit) ---
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USER=
MAIL_PASSWORD=
MAIL_AUTH=false
MAIL_STARTTLS=false
MAIL_FROM=no-responder@gestionobra.local

# --- Almacenamiento de archivos ---
# local: los comprobantes se guardan en un volumen de Docker
# s3: los comprobantes se guardan en Cloudflare R2 (producción)
STORAGE_TIPO=local

# --- URL pública del sistema (se usa en los enlaces de invitación) ---
APP_URL=http://localhost:3000

# --- Producción (ejemplo, no completar en el repositorio) ---
# MAIL_HOST=smtp-relay.brevo.com
# MAIL_PORT=587
# MAIL_USER=<usuario SMTP de Brevo>
# MAIL_PASSWORD=<clave SMTP de Brevo>
# MAIL_AUTH=true
# MAIL_STARTTLS=true
# STORAGE_TIPO=s3
# STORAGE_ENDPOINT=https://<id-de-cuenta>.r2.cloudflarestorage.com
# STORAGE_BUCKET=comprobantes
# STORAGE_REGION=auto
# STORAGE_ACCESS_KEY=<access key de R2>
# STORAGE_SECRET_KEY=<secret key de R2>
